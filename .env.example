# #######################################

# Used by `bun run workflow:mobile-spa` to build mobile SPA, upload assets to S3, and generate template
# MOBILE_S3_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
