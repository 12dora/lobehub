{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2020",
    "lib": ["ES2022", "DOM"],
    "types": ["node", "@cucumber/cucumber", "@playwright/test"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "paths": {
      "@/const/*": ["../packages/const/src/*", "../src/const/*"],
      "@/database/*": ["../packages/database/src/*"],
      "@/server/*": ["../apps/server/src/*", "../src/server/*"],
      "@/types/*": ["../packages/types/src/*", "../src/types/*"],
      "@/utils/*": ["../packages/utils/src/*", "../src/utils/*"],
      "@/*": ["../src/*"]
    }
  },
  "exclude": ["node_modules", "reports"],
  "extends": "../tsconfig.json",
  "include": ["src/**/*", "*.js"]
}
