{
  "compilerOptions": {
    "esModuleInterop": true,
    "ignoreDeprecations": "6.0",
    "lib": ["ES2022", "DOM"],
    "module": "commonjs",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2020",
    "types": ["node", "@playwright/test"]
  },
  "exclude": ["node_modules", "reports"],
  "extends": "../../tsconfig.json",
  "include": ["./**/*.ts", "./**/*.tsx"]
}
