# Copy to .env and fill in. See README.md for first-run notes.
#   cp .env.example .env

# Public origin the browser (and official CLI `--server`) use.
APP_URL=http://localhost:3210
LOBE_PORT=3210

# --- secrets (openssl rand -base64 32 for each) ---
KEY_VAULTS_SECRET=
AUTH_SECRET=
PLATFORM_MASTER_KEY=
POSTGRES_PASSWORD=
RUSTFS_ACCESS_KEY=admin
RUSTFS_SECRET_KEY=

# OIDC / official CLI device-code login (`lh login --server <APP_URL>`).
# Unset → ENABLE_OIDC is false: POST /oidc/device/auth returns 404 and tRPC ignores Oidc-Auth.
# Generate a one-line JWKS JSON from the repo root, then paste it here as JWKS_KEY
# (the script's sample env name OIDC_JWKS_KEY is wrong for this app — use JWKS_KEY):
#   node scripts/generate-oidc-jwk.mjs
# KEY_VAULTS_SECRET above is also required (OIDC cookies / key vault).
JWKS_KEY=

# S3 must resolve from the browser AND from the app container — never localhost.
# Compose refuses to start docker-compose.yml until both are set.
# Example: http://192.168.1.20:9000  (the host address that publishes RUSTFS_PORT)
S3_ENDPOINT=
S3_PUBLIC_DOMAIN=
RUSTFS_PORT=9000
RUSTFS_ADMIN_PORT=9001
POSTGRES_PORT=5432
LOBE_DB_NAME=lobechat

# First-run super admin. With BOOTSTRAP_ALLOW_CREATE=1 a one-time password is printed once:
#   docker compose logs lobehub | grep -A6 'Break-glass super admin'
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_ALLOW_CREATE=1
BOOTSTRAP_SUPER_ADMIN_PASSWORD=

# Module preset. `full` is required for a complete official CLI surface.
# `minimal` / `standard` disable modules that back lh kb / generate image / memory / bot / …
# See docs/enterprise/modules.md (CLI compatibility).
LOBE_MODULE_PRESET=full
# LOBE_MODULES_DISABLED=

# Official CLI (after the stack is up):
#   npx -y @lobehub/cli@latest login --server ${APP_URL}
#   LOBEHUB_SERVER=${APP_URL} LOBEHUB_CLI_API_KEY=sk-lh-... npx -y @lobehub/cli@latest agent list --json

# Optional / usually leave default
# AUTH_COOKIE_PREFIX=lobehub-enhanced
# AUTH_SSO_PROVIDERS=
# SEARXNG_URL=
# COMPOSE_PROFILES=search
# LOBE_NODE_HEAP_MB=1536
