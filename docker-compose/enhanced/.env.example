# LobeHub Enhanced — docker compose environment
#
# Copy to `.env` next to docker-compose.yml, fill in every value marked CHANGE ME,
# then run:  docker compose up -d
#
# Generate the three secrets with:
#   openssl rand -base64 32

# ===========================================================================
# Core
# ===========================================================================

# Public origin the browser uses. Also used for OAuth callbacks and presigned URLs.
APP_URL=http://localhost:3210

# Host port published for the app container (container always listens on 3210).
LOBE_PORT=3210

# Encrypts user-level API keys stored in the database. CHANGE ME.
KEY_VAULTS_SECRET=CHANGE_ME_BASE64_32_BYTES

# Better Auth signing secret. CHANGE ME.
AUTH_SECRET=CHANGE_ME_BASE64_32_BYTES

# Namespaces session cookies. Must differ per instance when several instances
# share a host or a parent domain, otherwise they log each other out.
AUTH_COOKIE_PREFIX=lobehub-enhanced

# Environment-configured SSO providers. Leave EMPTY when identity providers are
# managed from the admin console (ENABLE_DATABASE_OIDC=1) — a non-empty value
# shadows the database-driven providers.
AUTH_SSO_PROVIDERS=

# ===========================================================================
# Database (ParadeDB — pgvector + BM25 are required by the migrations)
# ===========================================================================

LOBE_DB_NAME=lobechat
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_PORT=5432

# ===========================================================================
# Platform secret encryption
# ===========================================================================

# AES-256 key-encryption key for every platform secret (provider keys, connector
# OAuth credentials, IdP client secrets). Base64 of EXACTLY 32 bytes.
#   openssl rand -base64 32
# Losing or rotating this without running the rewrap job makes all stored
# platform secrets permanently unreadable. CHANGE ME.
PLATFORM_MASTER_KEY=CHANGE_ME_BASE64_32_BYTES

# ===========================================================================
# Enterprise feature flags (all default OFF in the image; 1 turns them on)
# ===========================================================================

# Master switch: mounts /admin, the admin.* API and the admin console entry.
# (`ENABLE_ENTERPRISE_ADMIN` is an accepted alias.)
ENABLE_PLATFORM_ADMIN=1
# Platform-owned AI providers and models take over the user AI settings.
ENABLE_PLATFORM_MANAGED_AI=1
# Platform-managed skill catalog replaces user-owned skills.
ENABLE_PLATFORM_MANAGED_SKILLS=1
# Platform-managed connectors, including platform-hosted shared OAuth accounts.
ENABLE_PLATFORM_MANAGED_CONNECTORS=1
# Platform assistants are pushed to every user.
ENABLE_PLATFORM_MANAGED_AGENTS=1
# Settings default/lock policy resolution (platform default vs user override).
ENABLE_PLATFORM_SETTINGS_POLICY=1
# Database-driven branding (name, logos, favicon, primary colour) overrides the build-time brand.
ENABLE_RUNTIME_BRANDING=1
# Identity providers configured in the admin console instead of env vars.
ENABLE_DATABASE_OIDC=1

# ===========================================================================
# Database-driven OIDC activation
# ===========================================================================

# `supervisor` enables the admin "restart to activate" button. Any other value
# reports restart as unsupported.
PLATFORM_OIDC_RESTART_MODE=supervisor
# Last-known-good identity snapshot. Must be an absolute, normalised path on the
# `platform-oidc-lkg` named volume so it survives restarts.
PLATFORM_OIDC_LKG_PATH=/app/.lobe/platform-oidc-lkg.v1.json

# ===========================================================================
# First-run super admin bootstrap (idempotent — safe to leave configured)
# ===========================================================================

# On every boot the server seeds platform RBAC. When this email is set it also
# promotes that account to super_admin.
BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@example.com
# 1 = create the account if it does not exist yet (local email/password login).
BOOTSTRAP_ALLOW_CREATE=1
# Optional: 8–64 characters. When omitted a one-time password is generated and
# printed ONCE in the container log (`docker compose logs lobehub`).
# BOOTSTRAP_SUPER_ADMIN_PASSWORD=

# ===========================================================================
# Object storage (S3 compatible — required for uploads, knowledge base, files)
# ===========================================================================

# REQUIRED — CHANGE ME. S3_ENDPOINT is used for both the server-side SDK calls and the
# presigned URLs handed to the browser (S3_SET_ACL=0 means every read is presigned), so
# ONE address has to work from both sides:
#
#   * NOT `http://localhost:9000` — inside the app container `localhost` is the app itself.
#   * NOT `http://rustfs:9000`    — that name does not resolve in the user's browser.
#   * USE the host that publishes RUSTFS_PORT below, e.g.
#     http://192.168.1.20:9000  or  https://files.example.com
#
# Compose refuses to start while these are unset.
S3_ENDPOINT=http://<your-server-ip-or-domain>:9000
S3_PUBLIC_DOMAIN=http://<your-server-ip-or-domain>:9000

# Host port that publishes the object store. Must match the port in S3_ENDPOINT.
RUSTFS_PORT=9000
RUSTFS_ADMIN_PORT=9001
RUSTFS_ACCESS_KEY=admin
RUSTFS_SECRET_KEY=CHANGE_ME_RUSTFS_PASSWORD

# The bucket name is fixed at `lobe` (it is baked into bucket.config.json).

# ===========================================================================
# Optional
# ===========================================================================

# Allow the server to reach private/loopback addresses (single-box installs that
# call host services). Cloud metadata 169.254.169.254 stays blocked regardless.
# SSRF_ALLOW_PRIVATE_IP_ADDRESS=1

# Extra domain suffixes allowed by the ChatGPT Web provider transport.
# CHATGPT_WEB_ALLOWED_HOSTS=

# Outbound proxy, if you need one.
# HTTP_PROXY=http://localhost:7890
# HTTPS_PROXY=http://localhost:7890
